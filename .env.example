# Copy to .env.local and fill in values (never commit .env.local)
# Required
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB
NEXTAUTH_SECRET=replace_with_random_base64
NEXTAUTH_URL=http://localhost:3000

# Build-time (client bundle) if used
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (required if email features are enabled)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=example@yourdomain.com
SMTP_PASS=replace_me
SMTP_FROM="Canopy Forms <example@yourdomain.com>"

# Optional bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Feedback (optional) - recipient for the in-app "Give feedback" form in the
# help bubble. If unset, feedback submissions return a friendly error.
FEEDBACK_RECIPIENT_EMAIL=feedback@canopyds.com

# Support (optional) - recipient for the in-app "Contact support" form in the
# help bubble. Falls back to FEEDBACK_RECIPIENT_EMAIL when unset. Must be an
# address that can actually receive mail (a mailbox or an alias); a send-only
# address like forms@ will bounce support requests.
SUPPORT_RECIPIENT_EMAIL=support@canopyds.com

# Google Fonts API key — only needed to regenerate src/lib/google-fonts.ts
# Get one at: https://console.cloud.google.com/ → APIs & Services → Web Fonts API
# Usage: GOOGLE_FONTS_API_KEY=your_key npx tsx scripts/fetch-google-fonts.ts
GOOGLE_FONTS_API_KEY=replace_me
